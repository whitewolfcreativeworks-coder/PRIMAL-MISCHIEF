# ---- Game server (apps/server) ----
PORT=8787
HOST=0.0.0.0
# Serve the built client from the same process (single deployment). Set to false for API-only.
SERVE_CLIENT=true
# STATIC_DIR=/app/apps/client/dist
# Seconds an acting player may stay idle before the server auto-passes for them.
IDLE_TIMEOUT_SECONDS=600
# Minutes an empty room is kept for reconnection.
ROOM_TTL_MINUTES=30

# ---- Client build (apps/client) ----
# Only needed when the client is hosted separately from the server (e.g. GitHub Pages).
# VITE_SERVER_URL=wss://your-game-server.example.com/ws
